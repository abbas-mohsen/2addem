# Copy to .env and adjust. Never commit the real .env.

NODE_ENV=development
PORT=4000

# Where the browser app runs — used for CORS and for links inside emails.
CLIENT_URL=http://localhost:5173

MONGODB_URI=mongodb://127.0.0.1:27017/joinclone

# Use long random strings in any non-local environment.
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Local disk storage for dev. Swap STORAGE_DRIVER when an S3 driver is added.
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# Email notifications. With SMTP_HOST empty in development the app creates an
# Ethereal test inbox on first send and logs a preview link — nothing reaches a
# real address. Set these (e.g. Mailtrap) to send for real. Required in production.
EMAIL_ENABLED=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="2addem <no-reply@2addem.local>"
